-- =========================================================
-- Test 01: API functions
-- =========================================================
-- Set search path to include chronoturtle schema
SET search_path TO chronoturtle, public;
CREATE SCHEMA animal;
CREATE SCHEMA human;
-- =========================================================
-- VIE
-- =========================================================
-- throws if the table does not exist
SELECT migrate_to_vie('animal.dog');
ERROR:  Table animal.dog does not exist
CONTEXT:  PL/pgSQL function _vie_migration.assert_table_is_convertable_to_vie(text,text) line 7 at RAISE
SQL statement "SELECT _vie_migration.assert_table_is_convertable_to_vie(l_schema, l_table)"
PL/pgSQL function migrate_to_vie(text[]) line 25 at PERFORM
-- setup table
CREATE TABLE human.dog_owner
(
    id    SERIAL PRIMARY KEY,
    birth DATE NOT NULL,
    name  TEXT NOT NULL
);
CREATE TABLE animal.dog
(
    id           SERIAL PRIMARY KEY,
    birth        DATE NOT NULL,
    name         TEXT NOT NULL,
    race         TEXT NOT NULL,
    dog_owner_id INT  NOT NULL REFERENCES human.dog_owner (id)
);
-- throws without schema
SELECT migrate_to_vie('dog');
ERROR:  No schema for table dog defined
CONTEXT:  PL/pgSQL function _chronoturtle_internal.get_schema_and_table_name(text) line 4 at RAISE
SQL statement "SELECT schema_name, table_name                        FROM _chronoturtle_internal.get_schema_and_table_name(l_table_name)"
PL/pgSQL function migrate_to_vie(text[]) line 23 at SQL statement
-- throws because there is not backing table
SELECT show_backing_table_name('animal.dog');
ERROR:  No backing table found for animal.dog
CONTEXT:  PL/pgSQL function show_backing_table_name(text) line 16 at RAISE
-- migrates
SELECT migrate_to_vie('human.dog_owner', 'animal.dog');
 migrate_to_vie 
----------------
 
(1 row)

-- shows the backing table name
SELECT show_backing_table_name('animal.dog');
 show_backing_table_name 
-------------------------
 animal__dog
(1 row)

SELECT show_backing_table_name('human.dog_owner');
 show_backing_table_name 
-------------------------
 human__dog_owner
(1 row)

-- shows the view name
SELECT show_view_name(show_backing_table_name('animal.dog'));
 show_view_name 
----------------
 (animal,dog)
(1 row)

SELECT show_view_name(show_backing_table_name('human.dog_owner'));
  show_view_name   
-------------------
 (human,dog_owner)
(1 row)

-- check view
SELECT COUNT(*)
FROM pg_class c
         JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE c.relkind = 'v'
  AND n.nspname IN ('human', 'animal')
  AND c.relname IN ('dog', 'dog_owner');
 count 
-------
     2
(1 row)

SELECT column_name, data_type
FROM information_schema.columns
WHERE table_schema = 'animal'
  AND table_name = 'dog'
ORDER BY ordinal_position;
 column_name  | data_type 
--------------+-----------
 id           | integer
 birth        | date
 name         | text
 race         | text
 dog_owner_id | integer
(5 rows)

SELECT column_name, data_type
FROM information_schema.columns
WHERE table_schema = 'human'
  AND table_name = 'dog_owner'
ORDER BY ordinal_position;
 column_name | data_type 
-------------+-----------
 id          | integer
 birth       | date
 name        | text
(3 rows)

-- check backing tables
SELECT COUNT(*)
FROM pg_class c
         JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE c.relkind = 'r'
  AND n.nspname = '_backing'
  AND c.relname IN (show_backing_table_name('animal.dog'), show_backing_table_name('human.dog_owner'));
 count 
-------
     2
(1 row)

SELECT column_name, data_type
FROM information_schema.columns
WHERE table_schema = '_backing'
  AND table_name = show_backing_table_name('animal.dog')
ORDER BY ordinal_position;
      column_name      | data_type 
-----------------------+-----------
 id                    | integer
 birth                 | date
 name                  | text
 race                  | text
 dog_owner_id          | integer
 row_hash              | bytea
 human__dog_owner_hash | bytea
(7 rows)

SELECT column_name, data_type
FROM information_schema.columns
WHERE table_schema = '_backing'
  AND table_name = show_backing_table_name('human.dog_owner')
ORDER BY ordinal_position;
 column_name | data_type 
-------------+-----------
 id          | integer
 birth       | date
 name        | text
 row_hash    | bytea
(4 rows)

